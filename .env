# AI-HIDS Backend Environment Configuration
# ==========================================
# Paste your MongoDB connection URI below.
# Example (Atlas): mongodb+srv://user:pass@cluster0.abc123.mongodb.net/hids_db?retryWrites=true&w=majority
# Example (Local): mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017

# Name of the database to use
DATABASE_NAME=hids_db

# Fallback SQLite URL (used if MongoDB is unreachable)
SQLITE_URL=sqlite:///./hids.db

# FastAPI server settings
HOST=127.0.0.1
PORT=8000

# Sensor authentication & identification keys
SENSOR_ID=sensor-windows-testing
SENSOR_KEY=testing-secure-key-321

